# Where lead forms POST (Formspree, Netlify function, CRM webhook, Zapier hook, etc.).
# Leave empty in local dev: submissions are logged to the console instead.
PUBLIC_LEAD_ENDPOINT=
# Google Tag Manager container ID. Production: GTM-K3PBQCR9 (same as the live WordPress site).
# Leave empty in local dev so test leads do not pollute GA4/Ads data.
PUBLIC_GTM_ID=
