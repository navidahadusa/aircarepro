# CHICAGO AIRCARE PRO: production (aircareprohvac.com) on Hostinger
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# Force HTTPS + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://aircareprohvac.com/$1 [R=301,L]
# Trailing slash on folder URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
# Migration redirects (old WordPress URLs → new pages) are appended below by Elena Brooks.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|woff2?|webp|avif|jpg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
