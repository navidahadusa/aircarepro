# CHICAGO AIRCARE PRO: production (aircareprohvac.com) on Hostinger
Options -Indexes
DirectoryIndex index.html

# Security: this is a static site, so no PHP should ever run. Blocks leftover WordPress files
# (xmlrpc.php, wp-login.php, wp-admin, plugins) until the owner deletes them from public_html.
<FilesMatch "\.(php|phtml|phar)$">
  Require all denied
</FilesMatch>
RedirectMatch 301 ^/index\.php$ /
# Leftover WordPress URL patterns (indexing notice 2026-11-26)
RedirectMatch 301 ^/(blog/)?page/[0-9]+/?$ /blog/
RedirectMatch 301 ^/(privacy-policy|privacy)/?$ /privacy-policy-2/
RedirectMatch 301 ^/(about-us|about-2|our-company)/?$ /about/
RedirectMatch 301 ^/(service-area|areas-we-serve|locations)/?$ /service-areas/
# Old WordPress homepage slug + common legacy landing paths (Google Ads final URLs, old links). Elena Brooks 2026-11-21.
RedirectMatch 301 ^/home/?$ /
RedirectMatch 301 ^/(contact-us|contactus|get-in-touch)/?$ /contact/
RedirectMatch 301 ^/(book|book-now|booking|schedule|schedule-service|appointment)/?$ /free-estimate/
RedirectMatch 301 ^/(hvac-services|our-services)/?$ /services/
RedirectMatch 301 ^/(emergency|24-7|emergency-service|emergency-hvac-service)/?$ /emergency-hvac/
RedirectMatch 404 ^/(wp-admin|wp-includes|wp-json)(/.*)?$
RedirectMatch 404 ^/wp-content/(plugins|themes|upgrade|cache)/.*$
<FilesMatch "^(wp-config\.php|readme\.html|license\.txt|\.user\.ini|error_log)$">
  Require all denied
</FilesMatch>
RewriteEngine On
# /index.html and /dir/index.html -> clean URL (SEO audit 2026-11-25)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
# Force HTTPS + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://aircareprohvac.com/$1 [R=301,L]
# Trailing slash on folder URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
# Migration redirects (old WordPress URLs → new pages). Owner: Elena Brooks.
# All 34 posts and all live pages keep their exact URLs; only WordPress system URLs need redirects.
# Old WordPress / Rank Math sitemap URLs (saved in Google Search Console) → the new sitemap
RedirectMatch 301 ^/(sitemap|sitemap_index|wp-sitemap|page-sitemap|post-sitemap|category-sitemap|local-sitemap)\.xml$ /sitemap-index.xml
RedirectMatch 301 ^/feed/?$ /blog/
RedirectMatch 301 ^/comments/feed/?$ /blog/
RedirectMatch 301 ^/category/.*$ /blog/
RedirectMatch 301 ^/tag/.*$ /blog/
RedirectMatch 301 ^/author/.*$ /about/
RedirectMatch 301 ^/([0-9]{4})/([0-9]{2})/?$ /blog/
ErrorDocument 404 /404.html
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
# Security headers (Lighthouse Best Practices). No full script CSP yet: GTM tags vary.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|woff2?|webp|avif|jpg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
