---
/** 24/7 emergency dispatch page. Owners: Rachel Morgan (flow) + Chloe Vance (layout). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import CallSmsCta from '../../components/CallSmsCta.astro';
import FaqSection from '../../components/FaqSection.astro';
import { business } from '../../data/business';
const faqs = [
  { q: 'What counts as an HVAC emergency?', a: 'No heat in cold weather, no cooling during a heat wave (especially with infants, seniors or anyone with health conditions), water leaking from equipment, a burning smell, or a boiler that won’t fire.' },
  { q: 'What should I do while I wait with no heat?', a: 'Check the thermostat and breaker, replace a clogged filter if you can, keep interior doors open and faucets on exterior walls dripping. Never use a gas oven or grill to heat the home.' },
  { q: 'What if I smell gas or my CO alarm goes off?', a: 'Leave the home first and call 911 or your gas utility from outside. Once you’re safe, call us.' },
];
---
<BaseLayout title={`24/7 Emergency HVAC Repair | ${business.displayName}`}
  description={`No heat, no AC or a boiler problem at night or on a weekend? 24/7 emergency HVAC repair in Chicago. Call or text ${business.phoneDisplay} now.`}>
  <Breadcrumbs items={[{ name: '24/7 Emergency', href: '/emergency-hvac/' }]} />
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Emergency dispatch · 24/7</span>
        <h1>24/7 Emergency HVAC Service in Chicago</h1>
        <p class="lead">Calling is the fastest way to reach a technician, any time, nights and holidays included. Can’t talk right now? Send a dispatch request and we’ll call you back.</p>
        <a class="btn btn-emergency big" href={`tel:${business.phoneE164}`} data-track="click_to_call" data-placement="emergency_hero_big">📞 Call {business.phoneDisplay} now</a>
        <CallSmsCta placement="emergency_hero" showBooking={false} />
        <div class="safety">
          <strong>⚠️ Smell gas or hear a CO alarm?</strong> Leave the home and call 911 or your gas utility first. Then call us.
        </div>
      </div>
      <div id="dispatch"><LeadForm funnel="emergency" placement="emergency_hero" /></div>
    </div>
  </section>
  <section class="section"><div class="container prose"><FaqSection faqs={faqs} heading="Emergency questions" /></div></section>
</BaseLayout>
<style>
  .big { font-size: 1.2rem; padding: 1rem 1.5rem; margin-bottom: 1rem; }
  .safety { margin-top: 1.5rem; padding: 1rem; border-radius: var(--radius-sm); background: rgb(198 40 40 / 0.18); border: 1px solid rgb(255 255 255 / 0.25); color: #fff; }
</style>
