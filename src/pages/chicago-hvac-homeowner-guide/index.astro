    :global(.utility), :global(.emergency-banner), :global(.site-header), :global(.mobile-cta), :global(.pre-footer), :global(.site-footer), .toc, .share button, .cta-box { display: none !important; }
    :global(.hero) { background: none !important; color: #000 !important; }
