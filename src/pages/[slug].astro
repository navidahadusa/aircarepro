---
/**
 * Root-level pages: 20 services, 3 category hubs, and blog posts, all at /<slug>/ to mirror
 * the live WordPress URLs. Owner: Elena Brooks (routing). A build error is thrown if a
 * post slug collides with a service, category or reserved page path.
 */
import ServicePage from '../components/ServicePage.astro';
import BlogPost from '../components/BlogPost.astro';
import { categories, services, type Service, type Category } from '../data/services';
import { getPosts, type Post } from '../data/blog';
import { business } from '../data/business';

export async function getStaticPaths() {
  const reserved = new Set([
    ...services.map((s) => s.slug), ...categories.map((c) => c.slug),
    ...business.serviceAreas.map((a) => `hvac-${a.slug}`),
    'blog', 'service-areas', 'about', 'contact', 'reviews', 'financing', 'faq', 'services', 'sitemap', 'privacy-policy-2', 'emergency-hvac', 'free-estimate', 'maintenance-plan', 'thank-you', 'chicago-hvac-homeowner-guide',
  ]);
  const posts = await getPosts();
  for (const p of posts) {
    if (reserved.has(p.id)) throw new Error(`Blog post slug "${p.id}" collides with a site page. Rename the post file.`);
  }
  return [
    ...services.map((s) => ({ params: { slug: s.slug }, props: { kind: 'service' as const, service: s } })),
    ...categories.map((c) => ({ params: { slug: c.slug }, props: { kind: 'category' as const, category: c } })),
    ...posts.map((p) => ({ params: { slug: p.id }, props: { kind: 'post' as const, post: p } })),
  ];
}

type Props =
  | { kind: 'service'; service: Service }
  | { kind: 'category'; category: Category }
  | { kind: 'post'; post: Post };
const props = Astro.props as Props;
---
{props.kind === 'post' ? <BlogPost post={props.post} /> : <ServicePage {...props} />}
