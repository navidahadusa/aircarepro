---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallSmsCta from '../../components/CallSmsCta.astro';
import { business } from '../../data/business';
---

<BaseLayout title={`Thank You | ${business.name}`} description="We received your request." noindex>
  <section class="section container">
    <h1>Thanks, we got your request!</h1>
    <p id="ty-msg">A member of our team will contact you shortly.</p>
    <CallSmsCta placement="thank_you" sub="Need us sooner?" />
  </section>
  <script>
    const funnel = new URLSearchParams(location.search).get('funnel');
    const msg: Record<string, string> = {
      emergency: 'A dispatcher will call you back within minutes. Keep your phone nearby.',
      quote: 'A comfort advisor will reach out within one business day to schedule your estimate.',
      maintenance: 'We’ll contact you to confirm your tune-up date.',
    };
    const el = document.getElementById('ty-msg');
    if (el && funnel && msg[funnel]) el.textContent = msg[funnel];
  </script>
</BaseLayout>
