---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallSmsCta from '../../components/CallSmsCta.astro';
import { business, areasByGroup } from '../../data/business';
---

<BaseLayout
  title={`Service Areas | Chicago & Suburbs HVAC | ${business.displayName}`}
  description={`Heating and cooling service across Chicago's North, Northwest and West Sides and the north and northwest suburbs. Call ${business.phoneDisplay}.`}
>
  <section class="section container">
    <h1>Service Areas</h1>
    <p>Chicago’s North, Northwest and West Sides, the north and northwest suburbs, and Naperville.</p>
    <p><a href="/hvac-chicago/">HVAC service in Chicago →</a></p>
    <div class="areas">
      {[...areasByGroup()].map(([group, areas]) => (
        <div>
          <h2>{group}</h2>
          <ul>{areas.map((a) => <li><a href={`/hvac-${a.slug}/`}>{a.name}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <CallSmsCta placement="service_areas" heading="Not sure if we cover you? Call or text." />
  </section>
</BaseLayout>

<style>
  .areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem; margin-block: 1.5rem; }
</style>
