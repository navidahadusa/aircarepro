---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import CallSmsCta from '../../components/CallSmsCta.astro';
import { business } from '../../data/business';
---

<BaseLayout
  title={`24/7 Emergency HVAC Service | ${business.name}`}
  description={`No heat or no AC? Request emergency HVAC dispatch from ${business.name}. Call ${business.phoneDisplay}.`}
>
  <section class="hero container">
    <div>
      <h1>Emergency Heating & AC Repair</h1>
      <p>Calling is the fastest way to get a technician on the way. If you can’t talk right now, send a dispatch request and we’ll call you back.</p>
      <CallSmsCta placement="emergency_hero" heading="Fastest: call dispatch" />
      <h2>Safety first</h2>
      <p>If you smell gas, leave the home and call your gas utility or 911 before calling us.</p>
    </div>
    <LeadForm funnel="emergency" placement="emergency_hero" />
  </section>
</BaseLayout>
