---
/**
 * Homepage: Direction A "Lakefront Trust" (team-selected 2026-11-19; final approval: Sophia Reynolds).
 * Design: Chloe Vance · Copy/photos: Maya Lin · CTAs: Rachel Morgan · Structure: Elena Brooks.
 * Leads go to Housecall Pro (owner decision): BookingPanel replaces on-page forms.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CallSmsCta from '../components/CallSmsCta.astro';
import TrustBlock from '../components/TrustBlock.astro';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import FaqSection from '../components/FaqSection.astro';
import Icon from '../components/Icon.astro';
import RecentWork from '../components/RecentWork.astro';
import WinterScene from '../components/WinterScene.astro';
import { business, areasByGroup, heroHeadline, isHeatingSeason } from '../data/business';
import { photos } from '../data/photos';
import { categories, servicesIn } from '../data/services';
import { getPosts, blogCategories } from '../data/blog';

const hero = heroHeadline();
// Mobile/tablet hero: the photo is portrait (1050×1400) but shows as a wide strip under the text, so phones get a
// pre-cropped 16:10 version instead of downloading the full portrait (Lighthouse image savings, 2026-11-24). Chloe Vance.
// Winter hero (owner 2026-11-24): Nov–Feb shows an illustrated winter scene (no equipment, owner's call) in the style
// of the GBP cover; the rest of the year the condenser-cleaning photo returns. Chloe Vance.
const winter = isHeatingSeason();
const heroPhoto = photos.coilBrushing;
const heroCrops = await Promise.all([480, 760, 1050].map((w) => getImage({ src: heroPhoto.src, width: w, height: Math.round(w * 0.625), fit: 'cover', position: 'center', format: 'webp', quality: 40 })));
const heroMobileSrcset = heroCrops.map((c, i) => `${c.src} ${[480, 760, 1050][i]}w`).join(', ');
const googleUrl = business.reviewProfiles.find((p) => p.platform === 'Google')?.url;
const yelpUrl = business.reviewProfiles.find((p) => p.platform === 'Yelp')?.url;
const svcPhoto = { Heating: photos.carrierFurnace, Cooling: photos.newCondenserRoof, 'Air Quality': photos.humidifier } as const;
const svcGroups = categories.map((cat) => ({ cat, photo: svcPhoto[cat.name] }));
const allPosts = await getPosts();
// Seasonal picks (Maya Lin): winter topics Nov–Feb, cooling topics otherwise.
const m = new Date().getMonth();
const picks = (m >= 10 || m <= 1)
  ? ['furnace-wont-turn-on', 'boiler-not-heating', 'best-temperature-chicago-winter', 'carbon-monoxide-safety-tips']
  : ['ac-not-cooling', 'ac-freezing-up', 'prepare-ac-for-summer', 'mini-splits-for-older-homes'];
const featuredPosts = picks.map((id) => allPosts.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const steps = [
  { icon: 'gauge' as const, t: 'We test first', d: 'Gas pressure, temperature rise, refrigerant and electrical readings, measured before any part is replaced.' },
  { icon: 'clipboard' as const, t: 'You see the options', d: 'We explain what we found and give you choices with prices, before any work begins.' },
  { icon: 'wrench' as const, t: 'Repair with your OK', d: 'We repair what can be repaired, and recommend replacement only when it’s unsafe or uneconomical.' },
  { icon: 'sparkles' as const, t: 'We leave it clean', d: 'Shoe covers, protected floors, and the work area left the way we found it.' },
];
const triage = [
  { t: 'No heat or furnace problem', href: '/furnace-repair/', icon: 'flame' as const },
  { t: 'Boiler or radiator problem', href: '/boiler-repair/', icon: 'thermometer' as const },
  { t: 'AC not cooling', href: '/ac-repair/', icon: 'snowflake' as const },
  { t: 'Free estimate on a new system', href: '/free-estimate/', icon: 'clipboard' as const },
];
const faqs = [
  { q: 'Do you offer 24/7 emergency service?', a: `Yes. Call or text ${business.phoneDisplay} any time for no heat, no cooling or other urgent HVAC problems, including nights and holidays.` },
  { q: 'How do I book?', a: 'Use Book Online to pick a time on our scheduling page, or call or text us 24/7.' },
  { q: 'Which areas do you serve?', a: 'Chicago’s North, Northwest and West Sides and nearby suburbs including Evanston, Skokie, Wilmette, Highland Park, Des Plaines, Arlington Heights, Schaumburg and Naperville.' },
  { q: 'Are estimates free?', a: 'Estimates for new heating and cooling systems are free. Repair visits include a diagnosis, and you get the price before any repair starts.' },
  { q: 'Which brands do you work on?', a: `We service the brands common in Chicago homes, including ${business.brandsServiced.join(', ')}, and install ${business.dealerOf} equipment.` },
];
---

<BaseLayout
  title={`${business.displayName} | Heating, Cooling & HVAC Repair 24/7`}
  description={`Furnace, boiler and AC repair, installation and maintenance for Chicago homes. NATE-certified, 24/7 emergency service, free estimates. ${business.phoneDisplay}.`}
>
  <section class="home-hero2">
    <div class="h2-copy">
      <div class="h2-inner">
        {!hero.h1Lead && <p class="hero-kicker">{hero.eyebrow}</p>}
        <h1>{hero.h1Lead && <span class="h1-lead">{hero.h1Lead}<span class="sr-only">. </span></span>}{hero.h1}</h1>
        <p class="h2-lead">{hero.sub}</p>
        <CallSmsCta placement="home_hero" />
        <p class="h2-proof">City of Chicago License #{business.licenseNumber} · NATE-certified technicians · BBB accredited{googleUrl && <> · <a href={googleUrl} target="_blank" rel="noopener" data-track="click_review_link" data-placement="home_hero">See our Google reviews</a></>}{yelpUrl && <> · <a href={yelpUrl} target="_blank" rel="noopener" data-track="click_review_link" data-placement="home_hero_yelp">Yelp</a></>}</p>
      </div>
    </div>
    <div class:list={['h2-photo', { 'is-winter': winter }]}>
      {winter ? <WinterScene /> : (
      <picture>
        <source media="(max-width: 900px)" srcset={heroMobileSrcset} sizes="100vw" type="image/webp" />
        <Image quality={45} src={heroPhoto.src} alt={heroPhoto.alt} widths={[400, 640, 900]} sizes="45vw" loading="eager" fetchpriority="high" decoding="sync" />
      </picture>
      )}
      {winter && <>
        <div class="h2-winter" aria-hidden="true"></div>
        <p class="h2-tag"><strong>Furnace · Boiler · Heat pump</strong><span>Chicago &amp; suburbs · 24/7, nights and holidays</span></p>
      </>}
    </div>
  </section>

  <nav class="quick" aria-label="What do you need help with?">
    <div class="container quick-row">
      <p class="quick-title">What’s going on at your place?</p>
      <ul role="list">{triage.map((x) => <li><a href={x.href}>{x.t}<span aria-hidden="true">→</span></a></li>)}</ul>
    </div>
  </nav>

  <section class="brands" aria-label="Brands we service">
    <div class="container brands-row">
      <p>We service</p>
      <ul role="list">{business.brandsServiced.map((b) => <li class:list={{ dealer: b === business.dealerOf }}>{b}{b === business.dealerOf && <small>Authorized dealer</small>}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container process">
      <div class="photo process-photo">
        <Image quality={40} src={photos.gasPressureTest.src} alt={photos.gasPressureTest.alt} widths={[360, 480, 680]} sizes="(max-width: 900px) calc(100vw - 2rem), 35vw" />
      </div>
      <div>
        <h2>Diagnosis first. Options and prices before any work.</h2>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><div><strong>{s.t}</strong><p>{s.d}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head"><h2>Heating, cooling and air quality for Chicago homes</h2>
        <p class="lead">Gas furnaces, hot-water and steam boilers, central air, heat pumps and ductless mini-splits, in bungalows, two-flats, greystones and suburban homes.</p></div>
      <div class="svc3">
        {svcGroups.map((g) => (
          <article class="svc3-col">
            <a class="svc3-photo" href={`/${g.cat.slug}/`} tabindex="-1" aria-hidden="true">
              <Image quality={40} src={g.photo.src} alt={g.photo.alt} widths={[360, 540]} sizes="(max-width: 900px) 100vw, 30vw" />
            </a>
            <h3><a href={`/${g.cat.slug}/`}>{g.cat.name}</a></h3>
            <ul role="list">{servicesIn(g.cat.name).map((sv) => <li><a href={`/${sv.slug}/`}>{sv.name}</a></li>)}</ul>
            <a class="svc3-all" href={`/${g.cat.slug}/`}>All {g.cat.name.toLowerCase()} services →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {business.financingPartner && (
    <section class="finance">
      <div class="container finance-row">
        <div><h2>Replacing a furnace, boiler or AC?</h2><p>Free estimates on new systems. Financing through {business.financingPartner}, subject to credit approval.</p></div>
        <div class="finance-cta"><a class="btn btn-primary" href="/free-estimate/">Get a free estimate</a><a class="finance-link" href="/financing/">How financing works →</a></div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container boilers">
      <div>
        <h2>Steam and hot-water heat in greystones, two-flats and bungalows</h2>
        <p>Much of Chicago still heats with boilers. We troubleshoot pressure, air in the lines, low-water cut-offs, zone valves and circulators, and keep old radiator systems running safely.</p>
        <ul class="link-list">
          <li><a href="/boiler-repair/">Boiler repair <Icon name="arrow" size={16} /></a></li>
          <li><a href="/boiler-installation/">Boiler installation <Icon name="arrow" size={16} /></a></li>
          <li><a href="/carbon-monoxide-safety/">Carbon monoxide safety <Icon name="arrow" size={16} /></a></li>
          <li><a href="/chicago-hvac-homeowner-guide/">Chicago homeowner’s HVAC guide <Icon name="arrow" size={16} /></a></li>
        </ul>
      </div>
      <div class="photo boiler-photo">
        <Image quality={40} src={photos.boilerCirculator.src} alt={photos.boilerCirculator.alt} widths={[360, 480, 680]} sizes="(max-width: 900px) calc(100vw - 2rem), 35vw" />
      </div>
    </div>
  </section>

  <section class="section section-dark crew">
    <div class="container crew-grid">
      <div class="photo">
        <Image quality={40} src={photos.gangwayCondenser.src} alt={photos.gangwayCondenser.alt} widths={[360, 480, 720]} sizes="(max-width: 900px) calc(100vw - 2rem), 40vw" />
      </div>
      <div>
        <h2>A certified, owner-led crew, on call every day</h2>
        <p>Every technician is NATE and EPA 608 certified. We know Chicago housing, from gangway condensers to rooftop units and basement boilers.</p>
        <TrustBlock variant="credentials" />
      </div>
    </div>
  </section>

  <RecentWork />

  <section class="section section-alt">
    <div class="container"><ReviewsBlock /></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Chicago neighborhoods and nearby suburbs</h2>
        <p><a href="/hvac-chicago/">HVAC service in Chicago</a> · <a href="/service-areas/">All service areas</a></p></div>
      <div class="grid grid-4 areas">
        {[...areasByGroup()].map(([g, list]) => (
          <div><h3>{g}</h3><ul role="list">{list.map((a) => <li><a href={`/hvac-${a.slug}/`}>{a.name}</a></li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{m >= 10 || m <= 1 ? 'Winter guides for Chicago homes' : 'Cooling guides for Chicago homes'}</h2>
        <p><a href="/blog/">All {allPosts.length} HVAC guides <Icon name="arrow" size={16} /></a></p></div>
      <ul class="home-posts" role="list">
        {featuredPosts.map((p) => <li><a href={`/${p.id}/`}><span class="eyebrow">{blogCategories[p.data.category].name}</span><strong>{p.data.title}</strong><span>{p.data.description}</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid grid-2">
      <div class="prose"><FaqSection faqs={faqs} /></div>
      <div class="card guide-cta">
        <p class="kicker">Free homeowner resource</p>
        <h2>The Chicago Homeowner’s HVAC Guide</h2>
        <p>What to do when the heat goes out, how to prepare for a cold snap or heat wave, a month-by-month maintenance calendar and carbon monoxide safety.</p>
        <a class="btn btn-secondary" href="/chicago-hvac-homeowner-guide/">Read the guide <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero v2 (Chloe, Unslop redesign 2026-11-21): split editorial layout, real crew photo edge to edge, no floating card. */
  .home-hero2 { display: grid; grid-template-columns: 1.1fr 0.9fr; background: var(--navy-900); color: #e8f0f8; min-height: min(640px, 82vh); }
  .h2-copy { display: flex; align-items: center; justify-content: flex-end; padding: clamp(2.5rem, 5vw, 5rem) clamp(1rem, 4vw, 4rem) clamp(2.5rem, 5vw, 5rem) 1rem; }
  .h2-inner { max-width: 38rem; }
  .home-hero2 h1 { color: #fff; font-size: clamp(2.3rem, 1.6rem + 3vw, 3.9rem); line-height: 1.04; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .h2-lead { font-size: var(--step-1); color: #c9d8e8; max-width: 32rem; margin-bottom: 1.6rem; }
  .home-hero2 :global(.btn-secondary) { background: transparent; color: #fff; border-color: rgb(255 255 255 / 0.55); }
  .home-hero2 :global(.btn-secondary:hover) { background: rgb(255 255 255 / 0.1); color: #fff; }
  .h2-proof { margin: 1.4rem 0 0; font-size: 0.92rem; color: #a9bdd3; }
  .h2-photo { position: relative; min-height: 320px; }
  .h2-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 35% 40%; }
  /* Winter treatment (Nov–Feb), in the style of the GBP cover: navy blend from the text side, cool tint, light static snow. */
  .h2-winter { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--navy-900) 0%, rgb(14 38 72 / 0.45) 18%, rgb(14 38 72 / 0) 45%); }
  .h2-tag { position: absolute; left: clamp(1rem, 3vw, 2rem); bottom: clamp(1rem, 3vw, 2rem); margin: 0; padding: 0.75rem 1rem; max-width: calc(100% - 2rem);
    display: flex; flex-direction: column; gap: 0.15rem; background: rgb(14 38 72 / 0.78); backdrop-filter: blur(6px); border-radius: var(--radius); color: #fff; }
  .h2-tag strong { font-family: var(--font-heading); font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem); }
  .h2-tag span { color: #c9d8e8; font-size: 0.92rem; }
  @media (max-width: 600px) { .h2-tag { display: none; } }
  @media (max-width: 900px) {
    .home-hero2 { grid-template-columns: 1fr; min-height: 0; }
    .h2-copy { justify-content: flex-start; padding: 2.2rem 1rem 2rem; }
    .h2-photo { min-height: 0; aspect-ratio: 16 / 10; }
    .h2-winter { background: linear-gradient(180deg, var(--navy-900) 0%, rgb(14 38 72 / 0) 30%); }
    .h2-photo.is-winter { aspect-ratio: 4 / 3; }
  }

  .h2-proof a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .brands { background: #fff; border-bottom: 1px solid var(--border); }
  .brands-row { display: flex; align-items: center; gap: 1rem 2rem; padding-block: 1.1rem; flex-wrap: wrap; }
  .brands-row p { margin: 0; color: var(--muted); font-weight: 600; font-size: 0.95rem; }
  .brands ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; align-items: baseline; }
  .brands li { font-family: var(--font-heading); font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; color: #556375; }
  .brands li.dealer { color: var(--navy-900); }
  .brands li small { margin-left: 0.4rem; font-family: var(--font); font-weight: 700; font-size: 0.72rem; color: var(--cta); text-transform: uppercase; letter-spacing: 0.04em; }
  .finance { background: var(--navy-900); color: #e8f0f8; }
  .finance-row { display: flex; justify-content: space-between; align-items: center; gap: 1.25rem 2rem; flex-wrap: wrap; padding-block: clamp(1.75rem, 3vw, 2.5rem); }
  .finance h2 { color: #fff; margin: 0 0 0.35rem; font-size: var(--step-2); }
  .finance p { margin: 0; color: #c9d8e8; }
  .finance-cta { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .finance-link { color: #fff; font-weight: 700; }
  .quick { border-bottom: 1px solid var(--border); background: #fff; }
  .quick-row { display: grid; grid-template-columns: auto 1fr; gap: 1rem 2rem; align-items: center; padding-block: 1.1rem; }
  .quick-title { margin: 0; font-family: var(--font-heading); font-weight: 800; color: var(--navy-900); }
  .quick ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .quick li + li { border-left: 1px solid var(--border); }
  .quick a { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; min-height: 52px; padding: 0.4rem 1rem; font-weight: 700; color: var(--navy-900); text-decoration: none; }
  .quick a span { color: var(--cta); transition: transform 0.15s; }
  .quick a:hover span { transform: translateX(3px); }
  @media (max-width: 1000px) { .quick-row { grid-template-columns: 1fr; } .quick ul { grid-template-columns: 1fr 1fr; } .quick li:nth-child(3) { border-left: 0; } }
  @media (max-width: 560px) { .quick ul { grid-template-columns: 1fr; } .quick li + li { border-left: 0; border-top: 1px solid var(--border); } .quick a { padding-inline: 0; } }

  .svc3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); }
  .svc3-photo { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); margin-bottom: 1rem; }
  .svc3-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .svc3-col:hover .svc3-photo :global(img) { transform: scale(1.03); }
  .svc3-col h3 { margin-bottom: 0.6rem; } .svc3-col h3 a { color: var(--navy-900); text-decoration: none; }
  .svc3-col ul { list-style: none; margin: 0 0 1rem; padding: 0; columns: 2; column-gap: 1rem; }
  .svc3-col li { break-inside: avoid; padding: 0.25rem 0; }
  .svc3-col li a { color: var(--text); text-decoration: none; font-size: 0.95rem; }
  .svc3-col li a:hover { color: var(--brand-accent); text-decoration: underline; }
  .svc3-all { font-weight: 800; text-decoration: none; }
  @media (max-width: 900px) { .svc3 { grid-template-columns: 1fr; } }

  .process, .boilers, .crew-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .boilers { grid-template-columns: 1.2fr 1fr; }
  .process-photo, .boiler-photo { aspect-ratio: 4 / 5; max-height: 520px; }
  .crew-grid .photo { aspect-ratio: 4 / 5; max-height: 560px; }
  @media (max-width: 900px) {
    .process, .boilers, .crew-grid { grid-template-columns: 1fr; }
    .process-photo, .boiler-photo, .crew-grid .photo { aspect-ratio: 16 / 10; }
    .boilers .photo { order: -1; }
  }
  .steps { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1.1rem; }
  .steps li { display: flex; gap: 1.1rem; align-items: baseline; padding-top: 1rem; border-top: 1px solid var(--border); }
  .step-num { font-family: var(--font-heading); font-weight: 800; font-size: 1.5rem; color: var(--cta); min-width: 2.4rem; line-height: 1; }
  .h1-lead { display: block; font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem); font-weight: 700; letter-spacing: 0; color: #ffd9b8; margin-bottom: 0.5rem; }
  .hero-kicker { color: #c9d8e8; font-weight: 600; margin: 0 0 0.6rem; }
  .kicker { color: var(--muted); font-weight: 600; margin: 0 0 0.4rem; }
  .steps strong { font-family: var(--font-heading); color: var(--navy-900); font-size: 1.05rem; }
  .steps p { margin: 0.2rem 0 0; color: var(--muted); }
  .link-list { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 0.5rem; }
  .link-list a { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 800; text-decoration: none; }
  .crew p { color: #c9d6e6; }
  .areas ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.25rem; }
  .areas h3 { font-size: 1rem; }
  .guide-cta { align-self: start; border-top: 4px solid var(--cta); }
  .home-posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .home-posts a { display: grid; gap: 0.4rem; align-content: start; height: 100%; padding: 1.25rem; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: var(--text); }
  .home-posts a:hover { border-color: var(--blue-500); box-shadow: var(--shadow); }
  .home-posts strong { font-family: var(--font-heading); color: var(--navy-900); }
  .home-posts span:last-child { color: var(--muted); font-size: 0.9rem; }
</style>
