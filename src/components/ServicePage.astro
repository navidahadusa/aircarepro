---
/**
 * Service pages (/furnace-repair/ …) and category hubs (/heating/, /cooling/, /air-quality/).
 * Content: Maya Lin. Schema + internal links: Elena Brooks. Layout/CRO: Chloe Vance. Forms: Rachel Morgan.
 * Paths mirror the live WordPress site. Rendered by src/pages/[slug].astro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import CallSmsCta from '../components/CallSmsCta.astro';
import FaqSection from '../components/FaqSection.astro';
import ServiceCards from '../components/ServiceCards.astro';
import TrustBlock from '../components/TrustBlock.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { business } from '../data/business';
import { categories, services, servicesIn, serviceBySlug, type Service, type Category } from '../data/services';
import { buildServiceSchema } from '../lib/schema';
import { Image } from 'astro:assets';
import { servicePhoto, categoryPhoto } from '../data/photos';
import { postsForService, blogCategories } from '../data/blog';

type Props = { kind: 'service'; service: Service } | { kind: 'category'; category: Category };
const props = Astro.props as Props;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? business.url).toString();
const topAreas = business.serviceAreas.filter((a) => ['chicago', 'evanston', 'skokie', 'lincoln-park', 'lakeview', 'logan-square', 'andersonville-edgewater', 'arlington-heights', 'naperville'].includes(a.slug));

let svc: Service | undefined;
let cat: Category;
if (props.kind === 'service') {
  svc = props.service;
  cat = categories.find((c) => c.name === svc!.category)!;
} else {
  cat = props.category;
}
const related = svc ? svc.related.map(serviceBySlug).filter((x): x is Service => Boolean(x)) : [];
const catServices = servicesIn(cat.name);
const catFaqs = catServices.flatMap((s) => s.faqs.slice(0, 1)).slice(0, 5);
// Keyword-led title head from services.ts when present (≤ 38 chars + brand ≤ 60).
const title = svc
  ? svc.title
    ? `${svc.title} | ${business.displayName}`
    : `${svc.name} in Chicago | ${svc.funnel === 'emergency' ? '24/7 Service | ' : ''}${business.displayName}`
  : cat.title
    ? `${cat.title} | ${business.displayName}`
    : `${cat.name} Services in Chicago | ${business.displayName}`;
const sections = (svc ? svc.sections : cat.sections) ?? [];
// Service + city landing pages (routes built by Sophia: /<service>-<city>/).
const CITY_PAGE_SERVICES = ['furnace-repair', 'furnace-installation', 'ac-repair'];
const CITY_PAGE_SLUGS = ['chicago', 'evanston', 'skokie', 'wilmette', 'highland-park', 'des-plaines', 'arlington-heights', 'schaumburg', 'naperville'];
const cityLinks = svc && CITY_PAGE_SERVICES.includes(svc.slug)
  ? CITY_PAGE_SLUGS.map((slug) => business.serviceAreas.find((a) => a.slug === slug)).filter((a): a is NonNullable<typeof a> => Boolean(a))
      .map((a) => ({ name: a.name, href: `/${svc!.slug}-${a.slug}/` }))
  : [];
const description = svc ? svc.meta : cat.meta;
const photo = svc ? servicePhoto[svc.slug] ?? categoryPhoto[cat.slug] : categoryPhoto[cat.slug];
const blogPosts = svc ? await postsForService(svc.slug) : [];
const schema = buildServiceSchema({ name: svc ? svc.name : `${cat.name} services`, description, pageUrl });
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={svc ? [{ name: cat.name, href: `/${cat.slug}/` }, { name: svc.name, href: `/${svc.slug}/` }] : [{ name: cat.name, href: `/${cat.slug}/` }]} />
  <JsonLd data={schema} />

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>{svc ? `${svc.name} in Chicago` : cat.headline}</h1>
        <p class="lead">{svc ? svc.intro : cat.intro}</p>
        <CallSmsCta placement={`${svc ? svc.slug : cat.slug}_hero`} heading={svc?.funnel === 'emergency' ? 'Need it fixed now? Call or text 24/7' : undefined} />
        <ul class="badge-row">
          <li>NATE &amp; EPA 608</li><li>License #{business.licenseNumber}</li><li>BBB accredited</li><li>Free estimates on new systems</li>
        </ul>
      </div>
      <div id="quote"><LeadForm funnel={svc ? svc.funnel : 'quick'} placement={`${svc ? svc.slug : cat.slug}_hero`} /></div>
    </div>
  </section>

  {svc ? (
    <section class="section">
      <div class:list={['container', 'svc-grid', { 'has-photo': photo }]}>
        {photo && <div class="photo svc-photo"><Image quality={50} src={photo.src} alt={photo.alt} widths={[400, 700]} sizes="(max-width: 900px) 100vw, 30vw" /></div>}
        <div class="card">
          <h2>Signs you need {svc.name.toLowerCase()}</h2>
          <ul class="check-list">{svc.signs.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="card">
          <h2>What’s included</h2>
          <ul class="check-list">{svc.included.map((x) => <li>{x}</li>)}</ul>
          <p><small>You get the price before any work starts. Repairs are done only with your approval.</small></p>
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2>{cat.name} services</h2></div>
        <ServiceCards items={catServices} />
      </div>
    </section>
  )}

  {sections.length > 0 && (
    <section class="section svc-content">
      <div class="container svc-layout">
        <div class="prose svc-prose">
          {sections.map((s, i) => (
            <section id={`s-${i + 1}`} aria-labelledby={`s-${i + 1}-h`}>
              <h2 id={`s-${i + 1}-h`}>{s.h2}</h2>
              <Fragment set:html={s.html} />
            </section>
          ))}
        </div>
        <aside class="svc-aside">
          {sections.length > 2 && (
            <nav class="card side-box" aria-label="On this page">
              <h2 class="side-h">On this page</h2>
              <ul role="list" class="side-list">
                {sections.map((s, i) => <li><a href={`#s-${i + 1}`}>{s.h2}</a></li>)}
                <li><a href="#faq">Questions</a></li>
              </ul>
            </nav>
          )}
          {related.length > 0 && (
            <nav class="card side-box" aria-label="Related services">
              <h2 class="side-h">Related services</h2>
              <ul role="list" class="side-list">
                {related.map((r) => <li><a href={`/${r.slug}/`}>{r.name} <Icon name="arrow" size={16} /></a></li>)}
              </ul>
            </nav>
          )}
          <div class="card side-box">
            <h2 class="side-h">No heat or no AC right now?</h2>
            <p>We answer calls and texts 24/7, including nights and holidays.</p>
            <a class="btn btn-emergency" href="/emergency-hvac/#dispatch">Request emergency dispatch</a>
          </div>
        </aside>
      </div>
    </section>
  )}

  <section class="section section-alt">
    <div class="container">
      <div class="section-head"><h2>Diagnosis first. Options before any work.</h2></div>
      <TrustBlock />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <div class="prose">
        <FaqSection faqs={svc ? svc.faqs : catFaqs} heading={svc ? `${svc.name} questions` : `${cat.name} questions`} />
      </div>
      <div>
        {related.length > 0 && sections.length === 0 && (
          <>
            <h2>Related services</h2>
            <ServiceCards items={related} />
          </>
        )}
        {svc && cityLinks.length > 0 && (
          <>
            <h2 class:list={{ mt: related.length > 0 && sections.length === 0 }}>{svc.name} by city</h2>
            <ul class="area-pills" role="list">
              {cityLinks.map((c) => <li><a href={c.href}>{svc!.name} {c.name}</a></li>)}
            </ul>
          </>
        )}
        <h2 class="mt">{svc ? svc.name : cat.name} near you</h2>
        <p>We serve Chicago’s North, Northwest and West Sides and nearby suburbs.</p>
        <ul class="area-pills" role="list">
          {topAreas.map((a) => <li><a href={`/hvac-${a.slug}/`}>{a.name}</a></li>)}
          <li><a href="/service-areas/">All areas →</a></li>
        </ul>
      </div>
    </div>
  </section>
  {blogPosts.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2>From our blog</h2>
        <ul class="ruled" role="list">
          {blogPosts.map((p) => <li><a href={`/${p.id}/`}><strong>{p.data.title}</strong><small>{blogCategories[p.data.category].name}</small><Icon name="arrow" size={18} /></a></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .mt { margin-top: 2rem; }
  .svc-layout { display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 960px) {
    .svc-layout { grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); }
    .svc-aside { position: sticky; top: 6rem; align-self: start; }
  }
  .svc-aside { display: grid; gap: 1rem; align-content: start; }
  .side-h { font-size: 1.1rem; margin: 0 0 0.6rem; }
  .side-box p { margin-bottom: 0.9rem; }
  .side-list { list-style: none; padding: 0; margin: 0; }
  .side-list a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 40px; padding: 0.3rem 0; font-weight: 700; text-decoration: none; line-height: 1.35; }
  .side-list a :global(.icon) { transition: transform var(--dur-fast) var(--ease-out); }
  @media (hover: hover) { .side-list a:hover :global(.icon) { transform: translateX(3px); } }
  .svc-prose > section:first-child h2 { margin-top: 0; }
  @media (max-width: 959px) { .svc-aside > nav:first-child { display: none; } }
  .svc-grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr 1fr; }
  .svc-grid.has-photo { grid-template-columns: 0.9fr 1fr 1fr; align-items: stretch; }
  .svc-photo { min-height: 320px; }
  @media (max-width: 1000px) { .svc-grid, .svc-grid.has-photo { grid-template-columns: 1fr; } .svc-photo { aspect-ratio: 16 / 10; min-height: 0; } }
  .area-pills { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .svc-content { padding-top: 0; }
  .svc-prose > :global(h2:first-child) { margin-top: 0; }
  .svc-prose :global(h3) { margin: 1.4rem 0 0.4rem; font-size: 1.1rem; }
  .svc-prose :global(ol), .svc-prose :global(ul) { padding-left: 1.25rem; }
  .svc-prose :global(li) { margin-bottom: 0.35rem; }
  .svc-prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1rem 0 1.5rem; font-size: 0.95rem; }
  .svc-prose :global(th), .svc-prose :global(td) { border: 1px solid var(--border); padding: 0.6rem 0.75rem; text-align: left; vertical-align: top; }
  .svc-prose :global(th) { background: var(--blue-50); color: var(--navy-900); }
  .area-pills a { display: inline-block; padding: 0.4rem 0.85rem; border-radius: 999px; background: var(--blue-50); text-decoration: none; font-weight: 700; font-size: 0.9rem; }
</style>
