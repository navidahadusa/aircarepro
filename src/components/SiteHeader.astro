---
/**
 * Site header + navigation. Owner: Chloe Vance (UI/UX & CRO).
 * Fixes vs. live site: phone and Free Estimate CTA always visible, trust strip,
 * keyboard/no-JS accessible menus (<details>), compact mobile header (Call/Text live in the bottom bar).
 */
import NavList from './NavList.astro';
import { business, telHref } from '../data/business';
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <BrandMark size={58} />

    <nav class="desktop-nav" aria-label="Main">
      <NavList />
    </nav>

    <div class="header-cta">
      <a class="phone" href={telHref()} data-track="click_to_call" data-placement="header">
        <small>Call or text 24/7</small>{business.phoneDisplay}
      </a>
    </div>

    <a class="m-call" href={telHref()} data-track="click_to_call" data-placement="header_mobile" aria-label={`Call ${business.phoneDisplay}`}><Icon name="phone" size={22} /></a>
    <details class="mobile-toggle">
      <summary aria-label="Menu"><span class="burger" aria-hidden="true"></span><span class="label">Menu</span></summary>
      <nav class="mobile-nav" aria-label="Mobile">
        <NavList stacked />
        <a class="btn btn-primary block" href="/free-estimate/">Free Estimate</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // One dropdown open at a time; close on outside click or Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.has-menu > details')];
  menus.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) menus.forEach((o) => o !== d && (o.open = false));
  }));
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-menu')) menus.forEach((d) => (d.open = false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((d) => (d.open = false));
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: rgb(255 255 255 / 0.97); backdrop-filter: blur(6px); border-bottom: 1px solid var(--border); }
  .header-inner { display: flex; align-items: center; gap: 1rem; min-height: 80px; width: min(84rem, 100% - 2rem); }
  .desktop-nav { margin-left: auto; min-width: 0; }
  .header-cta { flex: none; display: flex; align-items: center; gap: 0.75rem; }
  .phone { display: grid; text-align: right; text-decoration: none; font-weight: 900; font-size: 1.15rem; color: var(--navy-900); line-height: 1.1; white-space: nowrap; }
  .phone small { font-size: 0.7rem; font-weight: 700; color: var(--green-600); text-transform: uppercase; letter-spacing: 0.05em; }
  .mobile-toggle { display: none; }
  .m-call { display: none; flex: none; }

  /* The red emergency strip above always shows the Call button, so the header phone yields to the menu on mid-size screens. */
  @media (max-width: 1399px) { .phone { display: none; } }
  @media (max-width: 1199px) {
    .desktop-nav { display: none; }
    .header-cta { margin-left: auto; }
    .mobile-toggle { display: block; }
    .mobile-toggle > summary { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0.75rem; min-height: 44px; font-weight: 800; cursor: pointer; list-style: none; border: 1px solid var(--border); border-radius: var(--radius-sm); }
    .mobile-toggle > summary::-webkit-details-marker { display: none; }
    .burger, .burger::before, .burger::after { display: block; width: 20px; height: 2px; background: var(--navy-900); content: ''; }
    .burger { position: relative; }
    .burger::before { position: absolute; top: -6px; } .burger::after { position: absolute; top: 6px; }
    .mobile-nav { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 1px solid var(--border); padding: 0.75rem 1rem 1rem; box-shadow: var(--shadow); max-height: calc(100vh - 140px); overflow: auto; }
    .block { width: 100%; margin-top: 0.75rem; }
  }
  @media (max-width: 400px) {
    .header-inner :global(.bm-logo) { width: 38px; height: 38px; }
    .m-call, .mobile-toggle > summary { width: 44px; height: 44px; padding: 0; justify-content: center; }
  }
  @media (max-width: 640px) {
    .hide-sm { display: none !important; }
    .header-inner { min-height: 68px; gap: 0.6rem; }
    .header-inner :global(.bm-logo) { width: 44px; height: 44px; }
    .header-inner :global(.brandmark) { flex: 1 1 auto; min-width: 0; }
    .phone { display: none; } /* Call/Text live in the sticky bottom bar on mobile */
    .m-call { display: inline-grid; place-items: center; width: 46px; height: 46px; margin-left: auto; border-radius: 12px; background: var(--cta); color: #fff; }
    .header-cta { margin-left: 0; }
    .mobile-toggle .label { display: none; }
  }
</style>
