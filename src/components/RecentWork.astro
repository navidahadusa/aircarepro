---
/**
 * "Recent work" gallery: the owner's own job photos (no stock). Design: Chloe Vance · Photo selection + alt text: Maya Lin.
 * Lazy-loaded, small responsive sizes so it doesn't affect LCP.
 */
import { Image } from 'astro:assets';
import { recentWork, type Photo } from '../data/photos';
import { business } from '../data/business';

interface Props { title?: string; intro?: string; items?: Photo[]; alt?: boolean }
const {
  title = 'Recent work from our crew',
  intro = `Real photos from ${business.displayName} jobs: boilers, furnaces, AC and indoor air quality.`,
  items = recentWork,
  alt = false,
} = Astro.props;
---
<section class:list={['section', { 'section-alt': alt }]} aria-labelledby="recent-work-h">
  <div class="container">
    <div class="section-head">
      <h2 id="recent-work-h">{title}</h2>
      <p class="lead">{intro}</p>
    </div>
    <ul class="rw-grid">
      {items.map((p) => (
        <li class="rw-item">
          <figure class="photo">
            <Image quality={50} src={p.src} alt={p.alt} widths={[300, 480]} sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 18rem" loading="lazy" />
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rw-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); }
  .rw-item figure { margin: 0; position: relative; aspect-ratio: 4 / 5; }
  .rw-item figcaption { position: absolute; inset: auto 0 0 0; padding: 2rem 0.75rem 0.7rem; font-size: 0.82rem; line-height: 1.35; font-weight: 600;
    color: #fff; background: linear-gradient(transparent, rgb(5 6 7 / 0.85)); }
  @media (max-width: 1000px) { .rw-grid { grid-template-columns: repeat(3, 1fr); } }
  /* Phones (2026-11-25): one swipeable row instead of a 2-column wall of photos (~1,500px shorter). No scroll-snap: it
     auto-scrolled on load and broke LCP measurement before (see ReviewsCarousel). */
  @media (max-width: 600px) {
    .rw-grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 62%; gap: 0.6rem; overflow-x: auto;
      margin-inline: -1rem; padding: 0 1rem 0.5rem; scrollbar-width: thin; overscroll-behavior-x: contain; }
    .rw-item figcaption { font-size: 0.74rem; padding: 1.5rem 0.5rem 0.5rem; }
  }
</style>
