---
/**
 * Accessible FAQ accordion + FAQPage schema. Owners: Maya Lin (content) + Elena Brooks (schema).
 * Answers must be visible on the page, matching the schema text exactly.
 */
import JsonLd from './JsonLd.astro';
import type { Faq } from '../data/services';

interface Props { faqs: Faq[]; heading?: string; id?: string }
const { faqs, heading = 'Common questions', id = 'faq' } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
{faqs.length > 0 && (
  <section class="faq" id={id} aria-labelledby={`${id}-h`}>
    <h2 id={`${id}-h`}>{heading}</h2>
    {faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <JsonLd data={schema} />
  </section>
)}

<style>
  .faq details { border: 1px solid var(--border); border-radius: var(--radius-sm); background: #fff; margin-bottom: 0.6rem; }
  .faq summary { cursor: pointer; padding: 1rem 1.1rem; font-weight: 800; color: var(--navy-900); list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-size: 1.3rem; line-height: 1; color: #08707e; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { padding: 0 1.1rem 1rem; margin: 0; color: var(--muted); }
</style>
