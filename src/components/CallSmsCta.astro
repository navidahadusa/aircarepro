---
/**
 * Inline call / text / book-online CTA group for heroes, service pages and footers.
 * `placement` is sent with tracking events so you can see which CTA converts.
 * The live site only had tel: links + an untracked Housecall Pro button; this
 * adds SMS ("Call or text 24/7" was promised but not linked) and tracks booking clicks.
 */
import { business, telHref, smsHref } from '../data/business';

interface Props {
  placement: string;
  heading?: string;
  sub?: string;
  showSms?: boolean;
  showBooking?: boolean;
  showCall?: boolean;
}
const { placement, heading, sub, showSms = true, showBooking = true, showCall = true } = Astro.props;
---

<div class="cta">
  {heading && <p class="cta-heading">{heading}</p>}
  {sub && <p class="cta-sub">{sub}</p>}
  <div class="cta-buttons">
    {showCall && (
      <a class="btn btn-primary" href={telHref()} data-track="click_to_call" data-placement={placement}>
        📞 Call {business.phoneDisplay}
      </a>
    )}
    {showSms && (
      <a class="btn btn-secondary" href={smsHref(business)} data-track="click_to_sms" data-placement={placement}>
        💬 Text Us
      </a>
    )}
    {showBooking && business.bookingUrl && (
      <a class="btn btn-secondary" href={business.bookingUrl} target="_blank" rel="noopener"
        data-track="click_book_online" data-placement={placement}>
        📅 Book Online <span class="sr-only">(opens in a new tab)</span>
      </a>
    )}
  </div>
</div>

<style>
  .cta { display: grid; gap: 0.5rem; }
  .cta-heading { font-size: 1.25rem; font-weight: 700; margin: 0; }
  .cta-sub { margin: 0; color: var(--muted); }
  .cta-buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
