---
/**
 * Trust signals + how-we-work process. Owner: Chloe Vance.
 * Only verified facts from business.ts. No invented stats, years or review counts.
 */
import { business } from '../data/business';
interface Props { variant?: 'full' | 'credentials' | 'estimate' }
const { variant = 'full' } = Astro.props;
const steps = [
  { t: 'Test the system', d: 'Gas pressure, temperature rise, refrigerant readings, electrical and airflow, measured before any part is replaced.' },
  { t: 'Explain what we found', d: 'You see the cause and your options, with prices, before any work begins.' },
  { t: 'Repair with your approval', d: 'We repair what can be repaired and recommend replacement only when it’s unsafe or uneconomical.' },
  { t: 'Leave it clean', d: 'Shoe covers, protected floors, and the work area left as we found it.' },
];
// New-system estimate process (free-estimate page; owner 2026-11-25: the repair steps didn't fit there).
const estimateSteps = [
  { t: 'Look at the home and the system', d: 'Your current furnace, boiler or AC, the ductwork or piping, the venting, and the rooms that are hard to heat or cool.' },
  { t: 'Size it to the home', d: 'We size the new system to the house with a load calculation, not by copying the old unit.' },
  { t: 'Written options with prices', d: `Free, in writing, with your options side by side. Financing through ${business.financingPartner}, subject to credit approval, and we check current utility rebates.` },
  { t: 'You decide, no pressure', d: 'If you go ahead, we install, start up and test the system, and leave the work area clean.' },
];
const creds = [
  { icon: 'license' as const, t: `City of Chicago License #${business.licenseNumber}`, d: 'Licensed for HVAC work in Chicago' },
  { icon: 'award' as const, t: 'NATE-certified technicians', d: 'Industry-recognized HVAC certification' },
  { icon: 'recycle' as const, t: 'EPA 608 certified', d: 'Legal, safe refrigerant handling' },
  { icon: 'shield' as const, t: 'BBB accredited', d: 'Accredited business, Better Business Bureau' },
  { icon: 'factory' as const, t: `${business.dealerOf} dealer`, d: 'Authorized dealer for new equipment' },
  { icon: 'clock' as const, t: 'Answering 24/7', d: 'Nights, weekends and holidays' },
];
---
<div class:list={["trust", { only: variant === "credentials" }]}>
  <ul class="creds" role="list">
    {creds.map((c) => <li><strong>{c.t}</strong><small>{c.d}</small></li>)}
  </ul>
  {variant !== "credentials" && <ol class="steps">
    {(variant === "estimate" ? estimateSteps : steps).map((s, i) => <li><span class="num" aria-hidden="true">{i + 1}</span><div><strong>{s.t}</strong><p>{s.d}</p></div></li>)}
  </ol>}
</div>

<style>
  .trust { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); align-items: start; }
  .creds { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .only { grid-template-columns: 1fr; }
  .only .creds { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); column-gap: 2rem; row-gap: 0; }
  :global(.section-dark) .creds li { border-top-color: rgb(255 255 255 / 0.18); }
  :global(.section-dark) .creds strong { color: #fff; }
  :global(.section-dark) .creds small { color: #c9d8e8; }
  .creds li { padding: 0.85rem 0; border-top: 1px solid var(--border); }
  .creds strong { display: block; color: var(--navy-900); font-family: var(--font-heading); font-size: 1.02rem; }
  .creds small { display: block; font-size: 0.92rem; }
  .creds small { color: var(--muted); }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .steps li { display: flex; gap: 1rem; }
  .steps p { margin: 0.2rem 0 0; color: var(--muted); }
  .num { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--navy-800); color: #fff; font-weight: 900; flex: none; }
</style>
